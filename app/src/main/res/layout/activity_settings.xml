<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_grid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_reset_progress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/action_reset_progress"
            android:textAllCaps="false"
            android:backgroundTint="#444444"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_contact_developer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/action_contact_dev"
            android:textAllCaps="false"
            android:backgroundTint="#444444"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_privacy_policy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/action_privacy_policy"
            android:textAllCaps="false"
            android:backgroundTint="#444444"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_dev_heading"
            android:textColor="#FFAA00"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_dev_name"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_email"
            android:textColor="#00BFA5"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_disclaimer"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>