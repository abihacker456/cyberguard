<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_cyber_grid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="#FF0000"
            android:textSize="28sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:shadowColor="#FF0000"
            android:shadowRadius="12"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_disclaimer"
            android:textColor="#FFAA00"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:background="@drawable/threat_card_bg"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_features"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_start_learning"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/onboarding_cta"
            android:textAllCaps="false"
            android:backgroundTint="#FF0000"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>