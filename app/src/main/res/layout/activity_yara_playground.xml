<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_grid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yara_playground_title"
            android:textColor="#FF0000"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yara_select_rule"
            android:textColor="#FFAA00"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinner_rule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#222222"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_rule_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:background="@drawable/threat_card_bg"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yara_sample_label"
            android:textColor="#FFAA00"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:gravity="top|start"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:hint="@string/yara_sample_hint"
            android:background="#222222"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_run_rule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/yara_run_button"
            android:textAllCaps="false"
            android:backgroundTint="#FF0000"
            android:textColor="@android:color/black"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:background="@drawable/threat_card_bg"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yara_explanation"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>