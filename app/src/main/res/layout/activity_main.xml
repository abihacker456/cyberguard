<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_grid">

    <TextView
        android:id="@+id/tv_educational_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tag_educational"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#AAFFAA00"
        android:rotation="-15"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#FF0000"
        android:shadowColor="#FF0000"
        android:shadowRadius="12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tv_lab_ready"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lab_ready"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="#AA00FF00"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_progress_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/progress_initial"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textColor="#FFAA00"
        app:layout_constraintTop_toBottomOf="@id/tv_lab_ready"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btn_open_apk_lab"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/action_open_apk_lab"
        android:textColor="#000000"
        android:backgroundTint="#FF0000"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginHorizontal="24dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_progress_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <LinearLayout
        android:id="@+id/ll_tools_row_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_open_apk_lab"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_open_quiz"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/action_open_quiz"
            android:textAllCaps="false"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_open_yara_playground"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/action_open_playground"
            android:textAllCaps="false"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tools_row_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/ll_tools_row_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_open_permissions"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/action_open_permissions"
            android:textAllCaps="false"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_open_encyclopedia"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/action_open_encyclopedia"
            android:textAllCaps="false"
            android:backgroundTint="#1A237E"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_lessons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/terminal_bg"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/ll_tools_row_2"
        app:layout_constraintBottom_toTopOf="@id/btn_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/action_settings"
        android:textAllCaps="false"
        android:backgroundTint="#444444"
        android:textColor="@android:color/white"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>