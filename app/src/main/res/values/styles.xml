<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.CyberGuard" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#00BFA5</item>
        <item name="colorPrimaryVariant">#00897B</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#FF6F00</item>
        <item name="colorSecondaryVariant">#E65100</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Transparent theme for ApkScanActivity -->
    <style name="Theme.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>