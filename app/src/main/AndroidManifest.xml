<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".CyberGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyberGuard">

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.CyberGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.ApkScanActivity" android:exported="false" />
        <activity android:name=".ui.LessonDetailActivity" android:exported="false" />
        <activity android:name=".ui.PhishingQuizActivity" android:exported="false" />
        <activity android:name=".ui.YaraPlaygroundActivity" android:exported="false" />
        <activity android:name=".ui.PermissionsActivity" android:exported="false" />
        <activity android:name=".ui.EncyclopediaActivity" android:exported="false" />
    </application>
</manifest>